# Copy to `.env` in this directory and replace every placeholder.
# Never commit the real file (it is git-ignored).

# --- PostgreSQL Connection ---
# For local container: leave POSTGRES_HOST=postgres, POSTGRES_PORT=5432
# For cloud database (Azure, Neon, Supabase):
#   POSTGRES_HOST=your-db.postgres.database.azure.com
#   POSTGRES_PORT=5432
#   POSTGRES_SSL_PARAM=&sslmode=require
#   POSTGRES_PY_SSL_PARAM=?ssl=require
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_SSL_PARAM=
POSTGRES_PY_SSL_PARAM=
# Host port binding when running local container (avoids clashing with local port 5432/5433)
POSTGRES_HOST_PORT=5434

# --- Secrets (>= 32 characters each, all different) ---
# User access-token signature: identity signs, every other service verifies.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# Service-to-service HS256 key shared by all services.
INTERNAL_SERVICE_JWT_SECRET=change-me-internal-secret-at-least-32-chars
# Dedicated key for trip cancellation previews (transport-service).
TRIP_CANCEL_PREVIEW_SECRET=change-me-trip-cancel-preview-secret-32chars

# --- Gateway / CORS ---
FRONTEND_URL=http://localhost:3009

# --- Kafka (container network uses kafka:29092 automatically) ---
KAFKA_IMAGE=apache/kafka:4.1.1
KAFKA_EXTERNAL_PORT=9094
KAFKA_CLUSTER_ID=NkYyZTI5Y2UtZjA0ZS00Mz
KAFKA_ORDER_TOPIC=logix.order.events.v1
KAFKA_INVENTORY_TOPIC=logix.inventory.events.v1
KAFKA_FULFILLMENT_TOPIC=logix.fulfillment.events.v1
KAFKA_TRANSPORT_TOPIC=logix.transport.events.v1
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# --- Agent service ---
# gemini | litellm_sdk | fake (fake needs no API key)
LLM_GATEWAY_BACKEND=fake
GEMINI_API_KEY=
PLANNER_DEFAULT_MODEL=gemini-3.8-flash
AGENT_MODEL=google_genai:gemini-3.8-flash
# `development` = in-memory checkpointer/confirmations (works out of the box).
# Anything else switches to Postgres and fails closed if it cannot initialise.
AGENT_ENVIRONMENT=development

# --- Route optimizer ---
OSRM_URL=https://router.project-osrm.org

# --- Forecast Service ---
FORECAST_SERVICE_URL=http://forecast-service:8002

# --- Compose Profiles ---
# `local-db` : starts local Postgres container (omit if using Cloud PostgreSQL)
# `ai`       : starts agent, forecast, and route-optimizer services
COMPOSE_PROFILES=local-db,ai
