{
    "name": "logix-backend",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.6.0",
    "scripts": {
        "dev": "turbo dev",
        "dev:route": "uv run uvicorn logix_route_optimizer.main:app --reload --port 8003",
        "dev:agent": "uv run uvicorn logix_agent.main:app --reload --port 8001",
        "dev:forecast": "uv run uvicorn logix_forecast.main:app --reload --port 8002",
        "build": "turbo build",
        "test": "turbo test",
        "lint": "turbo lint",
        "typecheck": "turbo typecheck",
        "db:migrate": "node scripts/migrate-all.mjs",
        "seed:master-data": "node scripts/seed-master-data.mjs"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^11.0.2",
        "oxlint": "^1.58.0",
        "turbo": "^2.5.6"
    }
}
