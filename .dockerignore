# Build context = repo root. Keep it small and never bake secrets into images.
.git
.gitignore
.vscode
.idea
.turbo
.pnpm-store

# Secrets: only *.env.example files may enter the context
**/.env
**/.env.*
!**/.env.example

# Dependencies / build output (rebuilt inside the image).
# Stale *.tsbuildinfo would make `tsc --incremental` skip emitting files.
**/node_modules
**/dist
**/build
**/*.tsbuildinfo
**/coverage

# Python artefacts
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Tests, docs and local data are not needed at runtime
**/test
**/tests
docs
infrastructure/local-data
**/*.log

