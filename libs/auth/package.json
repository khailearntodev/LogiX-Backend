{
  "name": "@logix/auth",
  "version": "0.0.1",
  "description": "Shared authentication interfaces, decorators, and permission guards for LogiX Backend",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
