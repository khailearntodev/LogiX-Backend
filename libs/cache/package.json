{
  "name": "@logix/cache",
  "version": "0.0.1",
  "description": "Multi-tenant distributed Redis cache with L1 in-memory fallback for LogiX Backend",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@logix/common": "workspace:*",
    "@logix/config": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^4.0.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.0.0"
  }
}
