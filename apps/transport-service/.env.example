DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<transport_database>
# User access-token signature shared with the API gateway and Identity.
JWT_SECRET=
# Must match downstream services' internal signing secret; no default.
INTERNAL_SERVICE_JWT_SECRET=
# Dedicated HS256 key for five-minute trip cancellation previews. Generate a
# random value of at least 32 characters; do not reuse either JWT secret above.
TRIP_CANCEL_PREVIEW_SECRET=
MASTER_DATA_SERVICE_URL=http://master-data-service:3001
FULFILLMENT_SERVICE_URL=http://fulfillment-service:3004
# Use addresses reachable from the Transport process (host and container
# networking differ). Timeout must be 1000-300000 milliseconds.
ROUTE_OPTIMIZER_SERVICE_URL=
ROUTE_OPTIMIZER_TIMEOUT_MS=
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=transport-service
KAFKA_GROUP_ID=logix-transport-service
KAFKA_FULFILLMENT_TOPIC=fulfillment.events
KAFKA_TRANSPORT_TOPIC=
# Required positive integers; configure explicitly for the deployment.
OUTBOX_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_RETRY_BASE_MS=
OUTBOX_RETRY_MAX_MS=
OUTBOX_TRANSACTION_TIMEOUT_MS=
RECOVERY_INTERVAL_MS=5000
