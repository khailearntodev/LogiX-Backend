DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<master_data_database>
JWT_SECRET=
INTERNAL_SERVICE_JWT_SECRET=
# Identity service origin, as used by the Gateway. Adapter appends /api/v1.
IDENTITY_SERVICE_URL=https://<identity-host>
# Transport origin; required even while trip mutation APIs are not implemented.
TRANSPORT_SERVICE_URL=https://<transport-host>
