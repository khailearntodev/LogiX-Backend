generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["audit"]
}

model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid
  actorType     String    @map("actor_type") @db.VarChar(30)
  action        String    @db.VarChar(100)
  entityType    String    @map("entity_type") @db.VarChar(100)
  entityId      String?   @map("entity_id") @db.Uuid
  outcome       String    @db.VarChar(30)
  beforeData    Json?     @map("before_data")
  afterData     Json?     @map("after_data")
  metadata      Json
  correlationId String    @map("correlation_id") @db.Uuid
  causationId   String?   @map("causation_id") @db.Uuid
  sourceService String    @map("source_service") @db.VarChar(100)
  sourceEventId String?   @map("source_event_id") @db.Uuid
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  ingestedAt    DateTime  @default(now()) @map("ingested_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       BigInt    @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt(sort: Desc), id], map: "ix_audit_tenant_time")
  @@index([tenantId, actorId, occurredAt(sort: Desc)], map: "ix_audit_actor_time")
  @@index([tenantId, action, occurredAt(sort: Desc)], map: "ix_audit_action_time")
  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)], map: "ix_audit_entity_time")
  @@index([tenantId, correlationId, occurredAt], map: "ix_audit_correlation")
  @@map("audit_logs")
  @@schema("audit")
}

model InboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  consumerName     String    @map("consumer_name") @db.VarChar(100)
  eventType        String    @map("event_type") @db.VarChar(100)
  aggregateId      String?   @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt?   @map("aggregate_version")
  processedAt      DateTime  @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome          String    @db.VarChar(30)
  errorCode        String?   @map("error_code") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          BigInt    @default(1)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([consumerName, eventId], map: "ux_inbox_consumer_event")
  @@index([tenantId, eventId], map: "ix_inbox_tenant_event")
  @@index([tenantId, aggregateId, aggregateVersion], map: "ix_inbox_aggregate")
  @@map("inbox_events")
  @@schema("audit")
}
