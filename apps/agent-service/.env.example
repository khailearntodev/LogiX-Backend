SERVICE_NAME=agent-service
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/logix_agent

# Must equal identity-service JWT_SECRET; requests are rejected while unset.
JWT_SECRET=change-me-same-as-identity-service

# Downstream services used by tools (forwarded with the caller's access token)
IDENTITY_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
MASTER_DATA_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004
TOOL_HTTP_TIMEOUT_SECONDS=10
TOOL_HTTP_MAX_ATTEMPTS=2

# LLM gateway: gemini | litellm_sdk | fake (fake needs no API key)
LLM_GATEWAY_BACKEND=fake
PLANNER_DEFAULT_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_FALLBACK_ENABLED=false
# GEMINI_API_KEY=
# PLANNER_FALLBACK_MODEL=

# Only for LLM_GATEWAY_BACKEND=litellm_sdk
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=
# OLLAMA_API_BASE=

PROMPT_POLICY_VERSION=v1
