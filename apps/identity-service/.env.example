KAFKA_INVENTORY_TOPIC=logix.inventory.events.v1
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
OUTBOX_TRANSACTION_TIMEOUT_MS=120000
