# ==============================================================================
# Route Optimizer Service Configuration (LogiX)
# ==============================================================================

SERVICE_NAME=route-optimizer-service
PORT=8003
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection string with asyncpg driver (route_optimizer schema)
# Local Docker Postgres runs on port 5433 (mapped from 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/logix_route_optimizer

# Shared HS256 secret for internal service-to-service authentication (Transport Service -> Route Optimizer)
# Must match INTERNAL_SERVICE_JWT_SECRET across all microservices (length >= 32 chars)
INTERNAL_SERVICE_JWT_SECRET=I8jaXWCnt+D5fZLmmSrlS+W+QOzJKJUaA+jjgiZPCd06SJyzSTht1HVCflB6gOCN

# OSRM (Open Source Routing Machine) Configuration for real-world driving distance & duration
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=4.0

# Fallback default vehicle capacity constraints (used when vehicle capacity is omitted)
DEFAULT_VEHICLE_CAPACITY_WEIGHT_KG=1000.0
DEFAULT_VEHICLE_CAPACITY_VOLUME_M3=8.0

