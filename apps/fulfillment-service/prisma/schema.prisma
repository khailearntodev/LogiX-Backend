generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["fulfillment"]
}

model Shipment {
  id                      String                  @id @default(uuid()) @db.Uuid
  tenantId                String                  @map("tenant_id") @db.Uuid
  shipmentNumber          String                  @map("shipment_number") @db.VarChar(50)
  orderId                 String                  @map("order_id") @db.Uuid
  warehouseId             String                  @map("warehouse_id") @db.Uuid
  deliveryAddressId       String                  @map("delivery_address_id") @db.Uuid
  /// Copied from the OrderConfirmed event; never re-read from Order or Master Data.
  customerSnapshot        Json                    @map("customer_snapshot")
  deliveryAddressSnapshot Json                    @map("delivery_address_snapshot")
  warehouseSnapshot       Json                    @map("warehouse_snapshot")
  orderNumber             String                  @map("order_number") @db.VarChar(50)
  confirmedOrderVersion   BigInt                  @map("confirmed_order_version")
  /// Tenant legal profile printed on dispatch documents (optional).
  issuerSnapshot          Json?                   @map("issuer_snapshot")
  status                  String                  @db.VarChar(20)
  totalWeight             Decimal                 @map("total_weight") @db.Decimal(18, 3)
  totalVolume             Decimal                 @map("total_volume") @db.Decimal(18, 6)
  reservationGroupId      String                  @map("reservation_group_id") @db.Uuid
  assignedTripId          String?                 @map("assigned_trip_id") @db.Uuid
  tripClaimId             String?                 @map("trip_claim_id") @db.Uuid
  dispatchIssuedAt        DateTime?               @map("dispatch_issued_at") @db.Timestamptz(6)
  readyAt                 DateTime?               @map("ready_at") @db.Timestamptz(6)
  deliveredAt             DateTime?               @map("delivered_at") @db.Timestamptz(6)
  failedAt                DateTime?               @map("failed_at") @db.Timestamptz(6)
  failureReason           String?                 @map("failure_reason") @db.Text
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 BigInt                  @default(1)
  deletedAt               DateTime?               @map("deleted_at") @db.Timestamptz(6)
  items                   ShipmentItem[]
  statusHistory           ShipmentStatusHistory[]
  dispatchIntent          ShipmentDispatchIntent?
  tripReceipts            ShipmentTripReceipt[]

  @@unique([tenantId, orderId], map: "ux_shipments_order")
  @@unique([tenantId, shipmentNumber], map: "ux_shipments_number")
  @@index([tenantId, orderId, status], map: "ix_shipments_order_status")
  @@map("shipments")
  @@schema("fulfillment")
}

model ShipmentTripReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  shipmentId      String   @map("shipment_id") @db.Uuid
  tripId          String   @map("trip_id") @db.Uuid
  claimId         String   @map("claim_id") @db.Uuid
  actorId         String   @map("actor_id") @db.Uuid
  operation       String   @db.VarChar(10)
  requestPayload  Json     @map("request_payload")
  responsePayload Json     @map("response_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  shipment        Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([tenantId, requestId], map: "ux_shipment_trip_receipts_request")
  @@index([tenantId, shipmentId, claimId], map: "ix_shipment_trip_receipts_claim")
  @@map("shipment_trip_receipts")
  @@schema("fulfillment")
}

model ShipmentDispatchIntent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  shipmentId      String   @unique @map("shipment_id") @db.Uuid
  orderVersion    BigInt   @map("order_version")
  shipmentVersion BigInt   @map("shipment_version")
  actorId         String   @map("actor_id") @db.Uuid
  correlationId   String   @map("correlation_id") @db.Uuid
  status          String   @db.VarChar(20)
  batchId         String?  @map("batch_id") @db.Uuid
  grantReceipt    Json?    @map("grant_receipt")
  rejectionReason String?  @map("rejection_reason") @db.VarChar(100)
  attemptCount    Int      @default(0) @map("attempt_count")
  nextAttemptAt   DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  shipment        Shipment @relation(fields: [shipmentId], references: [id])

  @@index([status, updatedAt], map: "ix_dispatch_intent_recovery")
  @@map("shipment_dispatch_intents")
  @@schema("fulfillment")
}

model ShipmentDispatchBatch {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  payload       Json
  payloadHash   String   @map("payload_hash") @db.VarChar(64)
  status        String   @db.VarChar(20)
  stage         String   @db.VarChar(20)
  decision      Json?
  response      Json?
  attemptCount  Int      @default(0) @map("attempt_count")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?  @map("last_error") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id], map: "ux_shipment_dispatch_batch_request")
  @@index([status, nextAttemptAt], map: "ix_shipment_batch_recovery")
  @@map("shipment_dispatch_batches")
  @@schema("fulfillment")
}

model ShipmentOrderCursor {
  tenantId     String  @map("tenant_id") @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  orderVersion BigInt  @map("order_version")
  canceled     Boolean @default(false)

  @@id([tenantId, orderId])
  @@map("shipment_order_cursors")
  @@schema("fulfillment")
}

model ShipmentItem {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  shipmentId          String    @map("shipment_id") @db.Uuid
  orderLineId         String    @map("order_line_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  skuSnapshot         String    @map("sku_snapshot") @db.VarChar(100)
  productNameSnapshot String    @map("product_name_snapshot") @db.VarChar(200)
  unitSnapshot        String    @map("unit_snapshot") @db.VarChar(30)
  quantity            Decimal   @db.Decimal(18, 3)
  weight              Decimal   @db.Decimal(18, 3)
  volume              Decimal   @db.Decimal(18, 6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version             BigInt    @default(1)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  shipment            Shipment  @relation(fields: [shipmentId], references: [id])

  @@unique([tenantId, shipmentId, orderLineId], map: "ux_shipment_items_order_line")
  @@index([tenantId, shipmentId], map: "ix_shipment_items_shipment")
  @@map("shipment_items")
  @@schema("fulfillment")
}

model ShipmentStatusHistory {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  shipmentId      String    @map("shipment_id") @db.Uuid
  fromStatus      String?   @map("from_status") @db.VarChar(20)
  toStatus        String    @map("to_status") @db.VarChar(20)
  reason          String?   @db.Text
  actorId         String?   @map("actor_id") @db.Uuid
  correlationId   String    @map("correlation_id") @db.Uuid
  shipmentVersion BigInt    @map("shipment_version")
  occurredAt      DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         BigInt    @default(1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  shipment        Shipment  @relation(fields: [shipmentId], references: [id])

  @@unique([tenantId, shipmentId, shipmentVersion], map: "ux_shipment_history_version")
  @@index([tenantId, shipmentId, occurredAt, id], map: "ix_shipment_history_timeline")
  @@map("shipment_status_history")
  @@schema("fulfillment")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(100)
  eventVersion     Int       @map("event_version")
  aggregateType    String    @map("aggregate_type") @db.VarChar(100)
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt    @map("aggregate_version")
  correlationId    String    @map("correlation_id") @db.Uuid
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  attemptCount     Int       @default(0) @map("attempt_count")
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          BigInt    @default(1)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, aggregateType, aggregateId, aggregateVersion], map: "ix_outbox_aggregate")
  @@map("outbox_events")
  @@schema("fulfillment")
}

model InboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  consumerName     String    @map("consumer_name") @db.VarChar(100)
  eventType        String    @map("event_type") @db.VarChar(100)
  aggregateId      String?   @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt?   @map("aggregate_version")
  eventPayload     Json?     @map("event_payload") @db.JsonB
  payloadHash      String?   @map("payload_hash") @db.VarChar(64)
  semanticKey      String?   @map("semantic_key") @db.VarChar(100)
  attemptCount     Int       @default(0) @map("attempt_count")
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error") @db.VarChar(100)
  processedAt      DateTime  @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome          String    @db.VarChar(30)
  errorCode        String?   @map("error_code") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          BigInt    @default(1)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([consumerName, eventId], map: "ux_inbox_consumer_event")
  @@index([tenantId, eventId], map: "ix_inbox_tenant_event")
  @@index([tenantId, aggregateId, aggregateVersion], map: "ix_inbox_aggregate")
  @@index([consumerName, outcome, nextAttemptAt], map: "ix_inbox_deferred_retry")
  @@index([tenantId, consumerName, semanticKey], map: "ix_inbox_semantic_result")
  @@map("inbox_events")
  @@schema("fulfillment")
}
