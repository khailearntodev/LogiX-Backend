NODE_ENV=development
PORT=3002
SERVICE_NAME=order-service
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/logix_order?schema=orders
# Must match identity-service JWT_SECRET (min 32 chars)
JWT_SECRET=
# Shared secret for service-to-service tokens (min 32 chars)
INTERNAL_SERVICE_JWT_SECRET=
MASTER_DATA_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004
ORDER_MAX_LINES=100