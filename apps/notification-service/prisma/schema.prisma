generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["notification"]
}

model Notification {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  type             String                  @db.VarChar(100)
  title            String                  @db.VarChar(200)
  body             String                  @db.Text
  severity         String                  @db.VarChar(20)
  entityType       String?                 @map("entity_type") @db.VarChar(100)
  entityId         String?                 @map("entity_id") @db.Uuid
  sourceEventId    String?                 @map("source_event_id") @db.Uuid
  deduplicationKey String?                 @map("deduplication_key") @db.VarChar(100)
  data             Json
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          BigInt                  @default(1)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)
  expiresAt        DateTime?               @map("expires_at") @db.Timestamptz(6)
  recipients       NotificationRecipient[]

  @@index([tenantId, entityType, entityId, createdAt(sort: Desc)], map: "ix_notifications_entity")
  @@index([tenantId, createdAt(sort: Desc)], map: "ix_notifications_created")
  @@map("notifications")
  @@schema("notification")
}

model NotificationRecipient {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  notificationId String                 @map("notification_id") @db.Uuid
  recipientType  String                 @map("recipient_type") @db.VarChar(20)
  recipientId    String                 @map("recipient_id") @db.Uuid
  readAt         DateTime?              @map("read_at") @db.Timestamptz(6)
  archivedAt     DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        BigInt                 @default(1)
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz(6)
  notification   Notification           @relation(fields: [notificationId], references: [id])
  deliveries     NotificationDelivery[]

  @@unique([tenantId, notificationId, recipientType, recipientId], map: "ux_notification_recipient")
  @@map("notification_recipients")
  @@schema("notification")
}

model NotificationDelivery {
  id                      String                @id @default(uuid()) @db.Uuid
  notificationRecipientId String                @map("notification_recipient_id") @db.Uuid
  channel                 String                @db.VarChar(20)
  status                  String                @db.VarChar(20)
  attemptCount            Int                   @default(0) @map("attempt_count")
  nextAttemptAt           DateTime?             @map("next_attempt_at") @db.Timestamptz(6)
  sentAt                  DateTime?             @map("sent_at") @db.Timestamptz(6)
  lastError               String?               @map("last_error") @db.Text
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 BigInt                @default(1)
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz(6)
  notificationRecipient   NotificationRecipient @relation(fields: [notificationRecipientId], references: [id])

  @@unique([notificationRecipientId, channel], map: "ux_delivery_channel")
  @@map("notification_deliveries")
  @@schema("notification")
}

model InboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  consumerName     String    @map("consumer_name") @db.VarChar(100)
  eventType        String    @map("event_type") @db.VarChar(100)
  aggregateId      String?   @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt?   @map("aggregate_version")
  processedAt      DateTime  @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome          String    @db.VarChar(30)
  errorCode        String?   @map("error_code") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          BigInt    @default(1)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([consumerName, eventId], map: "ux_inbox_consumer_event")
  @@index([tenantId, eventId], map: "ix_inbox_tenant_event")
  @@index([tenantId, aggregateId, aggregateVersion], map: "ix_inbox_aggregate")
  @@map("inbox_events")
  @@schema("notification")
}
