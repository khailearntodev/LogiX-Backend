# ==============================================================================
# Forecast Service Configuration (LogiX)
# ==============================================================================

SERVICE_NAME=forecast-service
PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection string with asyncpg driver (forecast schema)
# Local Docker Postgres runs on port 5434 (mapped from 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/logix_forecast

